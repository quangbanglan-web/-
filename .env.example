# ==============================================================================
# DOSKA — КОНФИГУРАЦИЯ СЕРВЕРА ДЛЯ ХОСТИНГА (NetAngels / VPS) И ЮKASSA
# Скопируйте этот файл в .env и укажите актуальные значения для боевого сервера
# ==============================================================================

# Порт приложения (NetAngels / Node.js)
PORT=3000

# Режим окружения: production (для продакшна) или development (для локальной разработки)
NODE_ENV=production

# Основной адрес сайта (используется для редиректов ЮKassa и вебхуков)
# Примеры: https://doska-edu.ru или http://localhost:3000
BASE_URL="http://localhost:3000"

# ----------------- ПЛАТЕЖНАЯ СИСТЕМА ЮKASSA -----------------
# Получите в личном кабинете ЮKassa (https://yookassa.ru/my):
# Настройки -> Ключи API
YOOKASSA_SHOP_ID="your_yookassa_shop_id"
YOOKASSA_SECRET_KEY="live_or_test_secret_key_here"

# ----------------- БЕЗОПАСНОСТЬ И АВТОРИЗАЦИЯ -----------------
# Секретный ключ для подписи JWT токенов (сгенерируйте длинную случайную строку)
JWT_SECRET="doska_production_jwt_secret_change_me_to_random_string_2026"

# ----------------- ИСКУССТВЕННЫЙ ИНТЕЛЛЕКТ (ОПЦИОНАЛЬНО) -----------------
# Google Gemini API ключ для решения математических задач и распознавания рукописного ввода
GEMINI_API_KEY=""
